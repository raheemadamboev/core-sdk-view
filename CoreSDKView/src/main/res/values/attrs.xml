<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- color of progress -->
    <attr name="colorProgress" format="reference" />

    <!-- background color of progress -->
    <attr name="colorBackgroundProgress" format="reference" />

    <!-- text color of Dialog button -->
    <attr name="colorDialogButtonText" format="reference" />

    <declare-styleable name="ProgressHorizontalView">
        <attr name="phvIsIndeterminate" format="boolean" />
        <attr name="phvMax" format="integer" />
        <attr name="phvProgressBackgroundColor" format="color" />
        <attr name="phvProgressColor" format="color" />
    </declare-styleable>
</resources>